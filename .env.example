# Copy to .env (never commit .env). Defaults shown.
# Provider: mock (free, rule-based) | gemini | anthropic | groq | openrouter | ollama
PROVIDER=mock
# Leave MODEL blank for the provider default (gemini-3.5-flash-lite, claude-haiku-5-5, llama-3.3-70b-versatile, ...)
MODEL=
API_KEY=
# Optional: override the endpoint (any OpenAI-compatible /chat/completions base URL)
BASE_URL=
# Free-tier limits: requests per minute / per day (Gemini free tier — check your current limits)
RPM=10
RPD=250
# Run only 20 major countries with the real model (others use mock leaders) — test this first
COUNTRIES=dev
# Cap leaders consulted per month (most urgent first); the rest continue current policies
MAX_AGENTS_PER_TURN=999
# Optional cost tracking for paid providers (USD per million tokens) and a hard stop
PRICE_IN_PER_M=0
PRICE_OUT_PER_M=0
MAX_SPEND_USD=0
# Detailed reports a leader asks for: next = attached to next month's briefing (free), now = extra request this month
DETAILED_REPORTS=next
# If false, revolutionaries holding the capital force a relocation instead of toppling the regime
REGIME_CAN_FALL=true
# One extra request per month for AI-written headlines and protest slogans (on|off)
FLAVOUR=on
