# Copy to .env (never commit .env). Defaults shown. Free-tier limits change often: check your provider console.
# Provider: mock (free, rule-based) | gemini | anthropic | groq | openrouter | ollama
PROVIDER=mock
# Leave MODEL blank for the provider default (gemini-3.5-flash-lite). Avoid gemini-3.8-flash on the free tier (≈5 RPM / 20 RPD).
MODEL=
API_KEY=
# Optional: override the endpoint (any OpenAI-compatible /chat/completions base URL)
BASE_URL=
# Rate limits (read from here, never hard-coded). Gemini Flash-Lite free tier ≈ 15 RPM, 500 RPD (late 2026)
RPM=15
RPD=500
# Optional tokens-per-minute cap (0 = none). Groq's free tier, for example, is limited by tokens, not requests
TPM=0
# Requests in flight at once (halves automatically after a 429, then recovers)
CONCURRENCY=4
# Which countries get AI leaders: dev = the 20 major powers every month (others rule-based);
# all = the 20 every month + crisis-triggered countries + a rotation, within a fixed monthly budget
COUNTRIES=dev
LLM_CALLS_PER_MONTH=50
MAX_MONTHS_WITHOUT_REVIEW=12
# Per-answer output cap and provider JSON mode (off if your provider rejects it; replies are repaired locally anyway)
MAX_OUTPUT_TOKENS=1200
JSON_MODE=on
# Optional second model for headlines, monthly narrative and constitution drafting (leaders always use MODEL)
SECONDARY_PROVIDER=
SECONDARY_MODEL=
SECONDARY_API_KEY=
# One request per month each: AI headlines/slogans, and a 5-bullet neutral monthly summary for the log
FLAVOUR=on
NARRATIVE=on
# Detailed reports a leader asks for: next = attached to next month's briefing (free), now = extra request this month
DETAILED_REPORTS=next
# Optional cost tracking for paid providers (USD per million tokens) and a hard stop
PRICE_IN_PER_M=0
PRICE_OUT_PER_M=0
MAX_SPEND_USD=0
# If false, revolutionaries holding the capital force a relocation instead of toppling the regime
REGIME_CAN_FALL=true
